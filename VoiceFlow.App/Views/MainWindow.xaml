<Window x:Class="VoiceFlow.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceFlow.App.ViewModels"
        xmlns:res="clr-namespace:VoiceFlow.App.Resources"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="VoicePod"
        Icon="pack://application:,,,/VoiceFlow;component/Resources/voiceflow.ico"
        Height="570"
        Width="750"
        MinHeight="460"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="14" />
    </WindowChrome.WindowChrome>

    <!-- Main Window Perimeter Border (crisp outline with subtle 2.3px line) -->
    <Border x:Name="WindowBorder"
            BorderBrush="{StaticResource LineaBrush}"
            BorderThickness="2.3"
            CornerRadius="14"
            Background="{StaticResource BackgroundBrush}"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar (integrated dark chrome) -->
            <Grid Grid.Row="0" Background="{StaticResource BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/VoiceFlow;component/Resources/voicepod-logo.png"
                           Width="20"
                           Height="20"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="VoicePod"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineaBrush}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="AI Voice Studio"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Draggable center area handled by WindowChrome -->
                <Grid Grid.Column="1" Background="Transparent" />

                <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) + Zoom Pill -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- Zoom Pill Controls -->
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineaBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            Padding="3,2"
                            VerticalAlignment="Center"
                            ToolTip="Zoom: Ctrl + / Ctrl - (o rueda)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="22"
                                    Height="22"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Click="OnZoomOutClick"
                                    ToolTip="Reducir (Ctrl -)">
                                <iconPacks:PackIconLucide Kind="Minus" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock x:Name="ZoomPercentText"
                                       Text="100%"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="5,0"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseDown="OnZoomResetClick"
                                       ToolTip="Restablecer 100% (Ctrl 0)" />
                            <Button Width="22"
                                    Height="22"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Click="OnZoomInClick"
                                    ToolTip="Agrandar (Ctrl +)">
                                <iconPacks:PackIconLucide Kind="Plus" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource WindowControlButton}"
                            Click="OnMinimizeClick"
                            ToolTip="Minimizar">
                        <iconPacks:PackIconLucide Kind="Minus" Width="11" Height="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}"
                            Click="OnMaximizeRestoreClick"
                            ToolTip="Maximizar / Restaurar">
                        <iconPacks:PackIconLucide x:Name="MaximizeIcon" Kind="Square" Width="11" Height="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Click="OnCloseClick"
                            ToolTip="{x:Static res:Strings.Close}">
                        <iconPacks:PackIconLucide Kind="X" Width="11" Height="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area with Zoom LayoutTransform & Responsive Scroll -->
            <ScrollViewer Grid.Row="1"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0"
                          Background="Transparent">
                <Grid x:Name="MainContentGrid" Margin="22,10,22,20">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                    </Grid.LayoutTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header & Navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="VoicePod" Style="{StaticResource HeaderText}" Margin="0,0,10,0" />
                                <Border Background="#224CC38A"
                                        BorderBrush="#444CC38A"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.MainSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource NavPillButton}"
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenHistoryCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="History" Width="13" Height="13" Foreground="{StaticResource TextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.TrayHistory}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavPillButton}"
                                    Command="{Binding OpenSettingsCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="Settings" Width="13" Height="13" Foreground="{StaticResource TextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.TraySettings}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Hotkey error banner -->
                    <Border Grid.Row="1"
                            Background="#33E05A5A"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="2.3"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,12"
                            Visibility="{Binding HotkeyError, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding HotkeyError}" Style="{StaticResource BodyText}" />
                    </Border>

                    <!-- Status & Action Card -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Status, Chips, Level meter -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SectionText}" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding StateDetail}" Style="{StaticResource MutedText}" />

                                <!-- Chips Info Row (Rounded with 2.3px Linea border) -->
                                <WrapPanel Margin="0,12,0,0">
                                    <!-- Hotkey Chip -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource LineaBrush}"
                                            BorderThickness="2.3"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="Keyboard" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HotkeyText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Mode Chip -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource LineaBrush}"
                                            BorderThickness="2.3"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="Radio" Width="12" Height="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- STT Engine Chip -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource LineaBrush}"
                                            BorderThickness="2.3"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="Zap" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EngineBadge}" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Profile Chip -->
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource LineaBrush}"
                                            BorderThickness="2.3"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="Sparkles" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ProfileBadge}" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Audio VU Level meter -->
                                <Border Height="10"
                                        Margin="0,12,0,0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource LineaBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        ClipToBounds="True">
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Value="{Binding AudioLevel, Mode=OneWay}"
                                                 Height="10"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Right Column: Primary & Secondary Action Buttons -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button Width="135"
                                        Height="42"
                                        Command="{Binding ToggleDictationCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <iconPacks:PackIconLucide Kind="Mic" Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Static res:Strings.MainDictate}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FFE84F4F" Offset="0" />
                                                                <GradientStop Color="#FFC82D2D" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#FFFF8080" />
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Detener" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Style="{StaticResource SecondaryActionButton}"
                                        Width="135"
                                        Height="36"
                                        Margin="0,8,0,0"
                                        IsEnabled="{Binding IsRecording}"
                                        Command="{Binding CancelDictationCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="X" Width="12" Height="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static res:Strings.Cancel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Result Card -->
                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Card Header: Title & Copy Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.MainLastDictation}" Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="0" />

                                <Button Grid.Column="1"
                                        Padding="10,4"
                                        Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding CopyLastResultCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavPillButton}">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <iconPacks:PackIconLucide Kind="Copy" Width="12" Height="12" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Copiar" FontSize="11" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <iconPacks:PackIconLucide Kind="Check" Width="13" Height="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="¡Copiado!" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <TextBox Grid.Row="1"
                                     Text="{Binding LastResult, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <!-- Footer Metrics Bar -->
                    <TextBlock Grid.Row="4"
                               Text="{Binding LastRecordingInfo}"
                               Style="{StaticResource MutedText}"
                               Margin="0,12,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
