<Window x:Class="VoiceFlow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceFlow.App.ViewModels"
        xmlns:res="clr-namespace:VoiceFlow.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{x:Static res:Strings.SettingsTitle}"
        Icon="pack://application:,,,/VoiceFlow;component/Resources/voiceflow.ico"
        Height="620"
        Width="780"
        MinHeight="520"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}">

            <!-- General -->
            <TabItem Header="{x:Static res:Strings.TabGeneral}">
                <StackPanel Margin="16">
                    <CheckBox Content="{x:Static res:Strings.SettingsStartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Content="{x:Static res:Strings.SettingsMinimizeToTray}" IsChecked="{Binding MinimizeToTrayOnClose}" />
                    <CheckBox Content="{x:Static res:Strings.SettingsPlaySounds}" IsChecked="{Binding PlaySounds}" />

                    <TextBlock Text="{x:Static res:Strings.SettingsLanguage}" Style="{StaticResource SectionText}" Margin="0,16,0,6" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Languages}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedLanguage}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsLanguageHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{x:Static res:Strings.SettingsPasteSection}" Style="{StaticResource SectionText}" Margin="0,20,0,6" />
                    <CheckBox Content="{x:Static res:Strings.SettingsRestoreClipboard}" IsChecked="{Binding RestoreClipboard}" />
                    <CheckBox Content="{x:Static res:Strings.SettingsTypeUnicode}"
                              IsChecked="{Binding TypeCharacterByCharacter}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{x:Static res:Strings.SettingsPasteDelay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBox Width="80" Margin="8,0,0,0" Text="{Binding PasteDelayMilliseconds}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Hotkey -->
            <TabItem Header="{x:Static res:Strings.TabHotkey}">
                <StackPanel Margin="16">
                    <TextBlock Text="{x:Static res:Strings.SettingsHotkeyCombination}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsHotkeyHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotkeyBox"
                                 Width="240"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding HotkeyText, Mode=OneWay}"
                                 ToolTip="{x:Static res:Strings.SettingsHotkeyHint}" />

                        <Button x:Name="RecordHotkeyButton"
                                Content="{x:Static res:Strings.SettingsHotkeyRecord}"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Click="OnRecordHotkeyClick" />

                        <Button Content="{x:Static res:Strings.SettingsHotkeyReset}"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Command="{Binding ResetHotkeyCommand}" />
                    </StackPanel>

                    <TextBlock x:Name="RecordingStatusText"
                               Text="{x:Static res:Strings.SettingsHotkeyListening}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />

                    <TextBlock Text="{Binding HotkeyMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HotkeyMessage, Converter={StaticResource NullToCollapsedConverter}}" />

                    <TextBlock Text="{x:Static res:Strings.SettingsHotkeyMode}" Style="{StaticResource SectionText}" Margin="0,22,0,6" />
                    <RadioButton Content="{x:Static res:Strings.SettingsHotkeyToggleOption}"
                                 IsChecked="{Binding IsPushToTalk, Converter={StaticResource InverseBooleanConverter}}" />
                    <RadioButton Content="{x:Static res:Strings.SettingsHotkeyHoldOption}"
                                 IsChecked="{Binding IsPushToTalk}" />
                </StackPanel>
            </TabItem>

            <!-- Audio -->
            <TabItem Header="{x:Static res:Strings.TabAudio}">
                <StackPanel Margin="16">
                    <TextBlock Text="{x:Static res:Strings.SettingsInputDevice}" Style="{StaticResource SectionText}" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="{x:Static res:Strings.SettingsMicTest}" Style="{StaticResource SectionText}" Margin="0,20,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120" Command="{Binding ToggleMicTestCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="{x:Static res:Strings.SettingsMicTestStart}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicTestRunning}" Value="True">
                                            <Setter Property="Content" Value="{x:Static res:Strings.SettingsMicTestStop}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ProgressBar Width="320"
                                     Height="12"
                                     Margin="12,0,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding MicLevel, Mode=OneWay}"
                                     Background="{StaticResource SurfaceAltBrush}"
                                     BorderThickness="0"
                                     Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="{x:Static res:Strings.SettingsMaxDuration}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBox Width="80" Margin="8,0,0,0" Text="{Binding MaxRecordingSeconds}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Transcription -->
            <TabItem Header="{x:Static res:Strings.TabTranscription}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <!-- Mode / Provider selector -->
                        <TextBlock Text="Motor de reconocimiento de voz" Style="{StaticResource SectionText}" />
                        <ComboBox HorizontalAlignment="Left"
                                  Width="420"
                                  ItemsSource="{Binding SttProviderOptions}"
                                  SelectedItem="{Binding SelectedSttProviderOption}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Cloud STT Section -->
                        <Border Style="{StaticResource Card}"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsCloudStt, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Modelo en la Nube (OpenRouter STT)" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Elige el modelo en la nube para procesar tu voz en tiempo récord y con máxima precisión." Style="{StaticResource MutedText}" Margin="0,0,0,10" />

                                <ComboBox ItemsSource="{Binding CloudModels}"
                                          SelectedItem="{Binding SelectedCloudModel}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Provider}" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="6,2" Margin="12,0,4,0">
                                                    <TextBlock Text="{Binding Pricing}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Details Card for Selected Model -->
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SelectedCloudModel.Id}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedCloudModel.Pricing}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                        </Grid>
                                        <TextBlock Text="{Binding SelectedCloudModel.Description}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,6,0,0"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- API Key Notice -->
                                <Border Margin="0,12,0,0"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="#224CC38A"
                                        BorderBrush="{StaticResource SuccessBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasApiKeyForCloudStt, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="✓ Clave de OpenRouter configurada en la pestaña IA."
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="#22E05A5A"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding HasApiKeyForCloudStt, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="⚠️ Requiere tu clave de OpenRouter. Configúrala en la pestaña IA para transcribir con este modelo."
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="💡 Si no hay conexión a internet o el servicio en la nube falla, VoicePod recurrirá automáticamente al motor local si está descargado."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Local STT Section -->
                        <Border Style="{StaticResource Card}"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsLocalStt, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SettingsModelFolder}" Style="{StaticResource SectionText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ModelDirectory}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.Browse}" Margin="8,0,0,0" Command="{Binding BrowseModelDirectoryCommand}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{x:Static res:Strings.SettingsThreads}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <TextBox Width="60" Margin="8,0,0,0" Text="{Binding NumThreads}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="{x:Static res:Strings.SettingsDownloadModel}" Command="{Binding DownloadModelCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Common Status & Reload -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:Strings.SettingsStatus}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ModelStatus}"
                                               Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Static res:Strings.SettingsReloadModel}" Command="{Binding ReloadModelCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI -->
            <TabItem Header="{x:Static res:Strings.TabAi}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <!-- Provider -->
                        <TextBlock Text="{x:Static res:Strings.SettingsProviderLabel}" Style="{StaticResource SectionText}" />
                        <ComboBox Width="220"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding LlmProviderOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedLlmProvider}" />

                        <!-- Endpoint -->
                        <TextBlock Text="{x:Static res:Strings.SettingsEndpoint}" Style="{StaticResource SectionText}" Margin="0,16,0,0" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                        <TextBlock Text="{x:Static res:Strings.SettingsEndpointExamples}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{x:Static res:Strings.OpenRouterHint}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding IsOpenRouter, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- API Key -->
                        <TextBlock Text="{x:Static res:Strings.SettingsApiKey}" Style="{StaticResource SectionText}" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox"
                                         Grid.Column="0"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="8,6"
                                         PasswordChanged="OnApiKeyChanged" />
                            <Button Grid.Column="1"
                                    Content="{x:Static res:Strings.SettingsGetApiKey}"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenApiKeyPageCommand}"
                                    Visibility="{Binding HasApiKeyUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.SettingsApiKeyHint}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />

                        <!-- Model Selection -->
                        <TextBlock Text="{x:Static res:Strings.SettingsModel}" Style="{StaticResource SectionText}" Margin="0,18,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="{x:Static res:Strings.SettingsBrowseModels}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseModelsCommand}" />
                        </Grid>

                        <!-- Parameters Card: Temperature & Max Tokens -->
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <!-- Temperature Section -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.SettingsTemperature}" Style="{StaticResource SectionText}" Margin="0,0,8,0" />
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TemperatureDisplay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{x:Static res:Strings.SettingsTemperaturePrecise}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Command="{Binding SetTemperaturePresetCommand}" CommandParameter="0.1" />
                                        <Button Content="{x:Static res:Strings.SettingsTemperatureBalanced}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Command="{Binding SetTemperaturePresetCommand}" CommandParameter="0.3" />
                                        <Button Content="{x:Static res:Strings.SettingsTemperatureCreative}"
                                                Padding="8,3" FontSize="11"
                                                Command="{Binding SetTemperaturePresetCommand}" CommandParameter="0.7" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0.0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                        Value="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,8,0,4" />
                                <TextBlock Text="{Binding TemperatureDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                                <!-- Max Tokens Section -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.SettingsMaxTokens}" Style="{StaticResource SectionText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MaxTokens}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding MaxTokensWordsEstimate}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{x:Static res:Strings.SettingsTokensShort}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Command="{Binding SetMaxTokensPresetCommand}" CommandParameter="512" />
                                        <Button Content="{x:Static res:Strings.SettingsTokensStandard}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Command="{Binding SetMaxTokensPresetCommand}" CommandParameter="1024" />
                                        <Button Content="{x:Static res:Strings.SettingsTokensLong}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                Command="{Binding SetMaxTokensPresetCommand}" CommandParameter="2048" />
                                        <Button Content="{x:Static res:Strings.SettingsTokensMax}"
                                                Padding="8,3" FontSize="11"
                                                Command="{Binding SetMaxTokensPresetCommand}" CommandParameter="4096" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="256" Maximum="4096" SmallChange="128" LargeChange="512"
                                        Value="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,8,0,4" />
                                <TextBlock Text="{Binding MaxTokensDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Reasoning (Thinking) Section Card -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Static res:Strings.SettingsReasoningTitle}" Style="{StaticResource SectionText}" Margin="0,0,0,2" />
                                        <TextBlock Text="{x:Static res:Strings.SettingsReasoningExplanation}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Content="{x:Static res:Strings.SettingsReasoningEnable}"
                                              IsChecked="{Binding EnableReasoning}"
                                              VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                                </Grid>

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding EnableReasoning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsReasoningEffort}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ReasoningEffortGroup"
                                                     Content="{x:Static res:Strings.SettingsReasoningLow}"
                                                     IsChecked="{Binding IsReasoningLow}"
                                                     Margin="0,0,16,0" />
                                        <RadioButton GroupName="ReasoningEffortGroup"
                                                     Content="{x:Static res:Strings.SettingsReasoningMedium}"
                                                     IsChecked="{Binding IsReasoningMedium}"
                                                     Margin="0,0,16,0" />
                                        <RadioButton GroupName="ReasoningEffortGroup"
                                                     Content="{x:Static res:Strings.SettingsReasoningHigh}"
                                                     IsChecked="{Binding IsReasoningHigh}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Timeout & Test Connection -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{x:Static res:Strings.SettingsTimeout}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <TextBox Width="70" Margin="8,0,16,0" Text="{Binding TimeoutSeconds}" />
                            <Button Content="{x:Static res:Strings.SettingsTestConnection}"
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ConnectionMessage}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ConnectionMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Profiles -->
            <TabItem Header="{x:Static res:Strings.TabProfiles}">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.New}" Command="{Binding NewProfileCommand}" />
                            <Button Content="{x:Static res:Strings.Duplicate}" Margin="0,6,0,0" Command="{Binding DuplicateProfileCommand}" />
                            <Button Content="{x:Static res:Strings.Delete}" Margin="0,6,0,0" Command="{Binding DeleteProfileCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 DisplayMemberPath="Name"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
                    </DockPanel>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{x:Static res:Strings.SettingsProfileName}" Style="{StaticResource BodyText}" />
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="{x:Static res:Strings.SettingsProfileUsesLlm}" IsChecked="{Binding ProfileUsesLlm}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.SettingsProfileModel}" Style="{StaticResource BodyText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBox Width="160" Margin="6,0,0,0" Text="{Binding ProfileModel}" />
                            <TextBlock Text="{x:Static res:Strings.SettingsProfileTemperature}" Style="{StaticResource BodyText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBox Width="60" Margin="6,0,0,0" Text="{Binding ProfileTemperature}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static res:Strings.SettingsProfilePrompt}" Style="{StaticResource BodyText}" />
                            <TextBox Text="{Binding ProfilePrompt, UpdateSourceTrigger=PropertyChanged}"
                                     Height="220"
                                     Margin="0,4,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static res:Strings.SettingsProfileSave}" Style="{StaticResource AccentButton}" Command="{Binding SaveProfileCommand}" />
                                <Button Content="{x:Static res:Strings.SettingsProfileRestore}" Margin="8,0,0,0" Command="{Binding RestoreProfilePromptCommand}" />
                                <Button Content="{x:Static res:Strings.SettingsProfileSetActive}" Margin="8,0,0,0" Command="{Binding SetActiveProfileCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProfileMessage}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ProfileMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- History -->
            <TabItem Header="{x:Static res:Strings.TabHistory}">
                <StackPanel Margin="16">
                    <TextBlock Text="{x:Static res:Strings.SettingsRetention}" Style="{StaticResource SectionText}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Strings.SettingsMaxEntries}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBox Width="90" Margin="8,0,16,0" Text="{Binding MaxEntries}" />
                        <TextBlock Text="{x:Static res:Strings.SettingsMaxAgeDays}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBox Width="90" Margin="8,0,0,0" Text="{Binding MaxAgeDays}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsRetentionHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0" />

                    <CheckBox Content="{x:Static res:Strings.SettingsSaveAudio}"
                              IsChecked="{Binding SaveAudio}"
                              Margin="0,16,0,0" />

                    <Button Content="{x:Static res:Strings.HistoryClearAll}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Command="{Binding ClearHistoryCommand}" />

                    <TextBlock Text="{Binding HistoryMessage}"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HistoryMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Close}" Click="OnCloseClick" />
            <Button Content="{x:Static res:Strings.Save}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
