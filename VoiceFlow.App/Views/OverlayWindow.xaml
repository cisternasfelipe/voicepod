<Window x:Class="VoiceFlow.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceFlow.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="VoiceFlow"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        Topmost="True"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

    <Border Background="#F21E2128"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10"
                         Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{Binding StateBrush}" />
                <TextBlock Text="{Binding StateText}"
                           Style="{StaticResource BodyText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ElapsedText}"
                           Style="{StaticResource MutedText}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ProgressBar Height="6"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding Level, Mode=OneWay}"
                         Background="{StaticResource SurfaceAltBrush}"
                         BorderThickness="0"
                         Foreground="{StaticResource SuccessBrush}"
                         Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock Text="{Binding DetailText}"
                       Style="{StaticResource MutedText}"
                       Margin="0,8,0,0"
                       MaxWidth="230"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding DetailText, Converter={StaticResource NullToCollapsedConverter}}" />
        </StackPanel>
    </Border>
</Window>
