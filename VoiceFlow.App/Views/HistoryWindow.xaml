<Window x:Class="VoiceFlow.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceFlow.App.ViewModels"
        xmlns:res="clr-namespace:VoiceFlow.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
        Title="{x:Static res:Strings.HistoryTitle}"
        Height="640"
        Width="900"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         VerticalAlignment="Center"
                         ToolTip="{x:Static res:Strings.HistorySearchHint}" />

                <ComboBox Grid.Column="1"
                          Width="170"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ProfileFilters}"
                          SelectedItem="{Binding ProfileFilter}" />

                <DatePicker Grid.Column="2"
                            Width="120"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding FromDate}" />

                <DatePicker Grid.Column="3"
                            Width="120"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding ToDate}" />

                <Button Grid.Column="4"
                        Content="{x:Static res:Strings.Clear}"
                        Margin="8,0,0,0"
                        Command="{Binding ClearFiltersCommand}" />
            </Grid>
        </Border>

        <!-- Entries -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Entries}"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalTimestamp}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="  ·  " Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ProfileName}" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                                <TextBlock Text="  ·  " Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding ProcessedText}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,8,0,0"
                                       MaxHeight="120"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2"
                                       Text="{Binding ProblemText}"
                                       Style="{StaticResource MutedText}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static res:Strings.HistoryCopyProcessed}"
                                        Command="{Binding DataContext.CopyProcessedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{x:Static res:Strings.HistoryCopyRaw}"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.CopyRawCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{x:Static res:Strings.HistoryReprocess}"
                                        Margin="8,0,0,0"
                                        Click="OnReprocessClick"
                                        Tag="{Binding}" />
                                <Button Content="{x:Static res:Strings.Delete}"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Refresh}" Command="{Binding RefreshCommand}" />
                <Button Content="{x:Static res:Strings.HistoryClearAll}"
                        Margin="8,0,0,0"
                        Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
